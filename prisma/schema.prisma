// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model QuoteRequest {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())

  industry    String
  boxType     String
  lengthMm    Int
  widthMm     Int
  depthMm     Int
  quantity    Int
  artworkUrl  String?

  contactName String
  companyName String
  email       String
  phone       String
  notes       String?

  status      QuoteStatus @default(NEW)
  emailSentAt DateTime?
}

enum QuoteStatus {
  NEW
  CONTACTED
  QUOTED
  CLOSED
}

model ContactMessage {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())

  name        String
  email       String
  phone       String?
  subject     String
  message     String

  emailSentAt DateTime?
  handled     Boolean   @default(false)
}

// --- Admin CMS auth (see docs/Admin_CMS_Implementation_Plan.pdf §4) ---
// DB-backed sessions rather than a JWT/OAuth library: small admin team,
// sessions need to be trivially revocable (delete the row), and this avoids
// pulling in an auth framework for what's effectively 1-2 users.
model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  id        String    @id @default(cuid())
  token     String    @unique
  user      AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
}

// --- CMS content models ---
// Field names/shapes mirror src/data/types.ts's Product interface directly
// (see Admin_CMS_Implementation_Plan.pdf §5.1 — "based on the existing
// TypeScript interfaces ... do not invent unnecessary fields"). isSeedData
// is replaced by isPublished: nothing goes live until an admin publishes it.
model Product {
  id                  String   @id @default(cuid())
  slug                String   @unique
  name                String
  categories          String[]
  industries          String[]
  boxType             String
  shortDescription    String
  description         String
  applications        String[]
  features            String[]
  fluteType           String
  wallType            String
  boardGrade          String
  ectRatingKnM        Float
  burstStrengthKpa    Float
  maxStackLoadKg      Float
  printingOptions     String[]
  moq                 String
  specSheetUrl        String?
  images              String[]
  relatedProductSlugs String[]
  isPublished         Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  standardSizes ProductStandardSize[]
}

model ProductStandardSize {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  label     String
  lengthMm  Int
  widthMm   Int
  depthMm   Int
}

// CaseStudySummary (problem/solution/result) is flattened to scalar columns
// since Postgres/Prisma has no first-class embedded-object type here.
// isVerified is kept SEPARATE from isPublished (unlike Product) — this is
// the load-bearing rule from docs/CLAUDE.md §9: a case study can never go
// live unless it's both verified AND published. Enforced in the Server
// Action, not just the schema.
model CaseStudy {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  industries      String[]
  summaryProblem  String
  summarySolution String
  summaryResult   String
  challenge       String
  solution        String
  clientQuote     String?
  clientName      String?
  clientCompany   String?
  images          String[]
  isVerified      Boolean  @default(false)
  isPublished     Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  results CaseStudyResultMetric[]
}

model CaseStudyResultMetric {
  id          String    @id @default(cuid())
  caseStudy   CaseStudy @relation(fields: [caseStudyId], references: [id], onDelete: Cascade)
  caseStudyId String
  label       String
  value       String
  unit        String?
}

// Status (Active/RenewingSoon/Expired) is deliberately NOT stored — it's
// computed at read time from renewalDate (see getCertificationStatus in the
// query module), matching the original static-data behavior and the site's
// "live-feeling status, not static prose" requirement.
model Certification {
  id                String   @id @default(cuid())
  name              String
  issuingBody       String
  certificationCode String   @unique
  badgeImageUrl     String?
  pdfUrl            String?
  issueDate         DateTime
  renewalDate       DateTime
  isPublished       Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model TeamMember {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  role        String
  photoUrl    String?
  bio         String
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Milestone {
  id          String   @id @default(cuid())
  slug        String   @unique
  year        Int
  title       String
  description String
  type        String
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Award {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  issuingBody String
  year        Int
  description String
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
